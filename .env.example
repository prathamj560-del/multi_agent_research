# ResearchMind environment template - copy to `.env` and fill in your keys.
# Get a free Groq key:  https://console.groq.com/keys
# Get a free Tavily key: https://app.tavily.com/

GROQ_API_KEY=gsk_your_groq_api_key_here
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Groq model. openai/gpt-oss-120b is the default for report quality;
# use openai/gpt-oss-20b when you need the lowest latency on the free tier.
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning (defaults shown)
# SEARCH_MAX_RESULTS=5
# NUM_SOURCES=3
# QUALITY_THRESHOLD=8
# MAX_REVISIONS=2
# LOG_LEVEL=INFO
# LOG_JSON=false
