# Groq API Key (Get a free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily API Key for web search (Get a free key from https://app.tavily.com/)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Recommended Groq model for Free Tier (30,000 TPM limit to avoid 429 rate limit errors):
GROQ_MODEL=llama-3.1-8b-instant

# Alternative models:
# GROQ_MODEL=llama-3.3-70b-versatile  (Requires higher quota / tier)
# GROQ_MODEL=mixtral-8x7b-32768
